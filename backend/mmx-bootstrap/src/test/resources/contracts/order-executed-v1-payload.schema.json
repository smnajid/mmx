{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Payload shape for Kafka OrderExecutedV1 — mirror specs/002-trader-orders-views/contracts/asyncapi.yaml components/schemas/OrderExecutedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "orderId",
    "executedAt",
    "orderType",
    "orderOperation",
    "portfolioNumber",
    "currency",
    "amount",
    "valueDate",
    "executedRate",
    "counterparty",
    "dealingReference",
    "contractNumber",
    "externalOrderReference"
  ],
  "properties": {
    "eventType": {
      "type": "string",
      "const": "OrderExecutedV1"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderType": {
      "type": "string",
      "enum": ["TERM", "ON_CALL"]
    },
    "orderOperation": {
      "type": "string",
      "enum": ["SUBSCRIPTION", "INCREASE", "DECREASE", "REDEMPTION"]
    },
    "portfolioNumber": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number"
    },
    "valueDate": {
      "type": "string",
      "format": "date"
    },
    "executedRate": {
      "type": "number"
    },
    "counterparty": {
      "type": "string",
      "minLength": 1
    },
    "dealingReference": {
      "type": "string",
      "minLength": 1
    },
    "contractNumber": {
      "type": "string",
      "minLength": 1
    },
    "externalOrderReference": {
      "type": "string",
      "minLength": 1
    },
    "tenor": {
      "type": ["string", "null"]
    },
    "noticePeriod": {
      "type": ["string", "null"]
    }
  }
}
