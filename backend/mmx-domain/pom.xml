<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mmx</groupId>
        <artifactId>mmx-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mmx-domain</artifactId>
    <name>mmx-domain</name>
    <description>Domain layer: aggregate root, value objects, enums, domain exceptions. Zero framework dependencies.</description>

    <!--
        CONSTITUTIONAL RULE: mmx-domain MUST have ZERO runtime dependencies
        beyond the Java standard library. No Spring, no JPA, no Jackson.
        Only JUnit 5 + AssertJ are permitted in test scope.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!--
                                Do not publish test resources (e.g. JUnit platform config) to
                                consumers of this test-jar: parallel-execution settings scoped to
                                THIS module must not leak into mmx-bootstrap's test runs.
                            -->
                            <excludes>
                                <exclude>junit-platform.properties</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Parallel pure-unit execution, scoped to this module only (spec
                        test-feedback-loop). Delivered via surefire configurationParameters instead
                        of junit-platform.properties because the properties file leaks to downstream
                        modules through reactor test-jar/test-classes resolution.
                    -->
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.parallel.enabled = true
                            junit.jupiter.execution.parallel.mode.default = concurrent
                            junit.jupiter.execution.parallel.mode.classes.default = concurrent
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
